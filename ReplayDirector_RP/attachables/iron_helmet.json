{
    "format_version": "1.20.60",
    "minecraft:attachable": {
        "description": {
            "identifier": "minecraft:iron_helmet",
            "item": {
                "minecraft:iron_helmet": "query.is_owner_identifier_any('replay:actor')"
            },
            "materials": {
                "default": "entity_alphatest"
            },
            "textures": {
                "default": "textures/models/armor/iron_1"
            },
            "geometry": {
                "default": "geometry.humanoid.armor.helmet"
            },
            "scripts": {
                "parent_setup": "v.helmet_layer_visible = false;"
            },
            "render_controllers": [
                "controller.render.replay_armor"
            ]
        }
    }
}
