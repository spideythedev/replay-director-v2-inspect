      "anim_time_update": "query.modified_distance_moved",
      "loop": true,
      "bones": {
        "leftLeg": {
          "rotation": [
            "math.cos(query.anim_time * 38.17) * 55.0",
            0.0,
            0.0
          ]
        },
        "rightLeg": {
          "rotation": [
            "math.cos(query.anim_time * 38.17 + 180.0) * 55.0",
